# ============================================================
# Lemon's AI Agent — Environment Variables (.env.example)
# ============================================================
# Copy this file to `.env` and fill in your actual values.
#   cp .env.example .env
#
# Full documentation: docs/ENV_CONFIG.md
#
# ⚠️  SECURITY WARNING:
# - `.env` is listed in `.gitignore` and MUST NEVER be committed.
# - `.env.example` is safe to commit — it contains no real secrets.
# - Rotate your API keys immediately if they ever leak to a public repo.
# ============================================================

# ============ Database ============
# PostgreSQL connection string
DATABASE_URL=postgresql://admin:password@localhost:5432/ai_dashboard_db

# ============ Auth ============
# HMAC-SHA256 signing secret for auth token cookies
ACCESS_PASSWORD=change-me-to-a-random-string

# ============ Node Environment ============
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============ LLM / AI Providers ============
# Priority: NVIDIA → DeepSeek → OpenRouter → OpenAI
# Just set one — the system auto-selects the first available.

# --- NVIDIA NIM (Primary, recommended) ---
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxx
NVIDIA_MODEL=deepseek-ai/deepseek-v4-pro

# --- DeepSeek ---
# DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# --- OpenRouter ---
# OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxx

# --- OpenAI ---
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# --- Agnes AI (Photo Analysis) ---
# AGNES_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx

# --- Google Gemini (Photo Analysis) ---
# GEMINI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx

# --- LLM Timeout (seconds) ---
LLM_TIMEOUT=120

# ============ Local LLM (LM Studio) ============
# LMSTUDIO_BASE_URL=http://192.168.0.186:1234/v1
# LMSTUDIO_MODEL=qwen/qwen3.5-9b-Q4

# ============ Speech-to-Text / Whisper ============
# WHISPER_PYTHON=~/.whisper-venv/bin/python3
# HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxx

# ============ Macro Economic (FRED) ============
FRED_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============ LLM Observability (Langfuse) ============
# LANGFUSE_PUBLIC_KEY=pk-lf-xxxxxxxxxxxxxxxxxxxxxxxx
# LANGFUSE_SECRET_KEY=sk-lf-xxxxxxxxxxxxxxxxxxxxxxxx
# LANGFUSE_HOST=https://cloud.langfuse.com
# NEXT_PUBLIC_LANGFUSE_URL=https://cloud.langfuse.com
